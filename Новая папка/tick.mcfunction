# =============================================
# Создаем счетчик достижений (если его нет)
# =============================================
scoreboard objectives add achivments dummy "§6Достижения"

# =============================================
# Копируем количество разблокированных ачивок
# в наш счетчик (обновляется каждый тик)
# =============================================
execute as @a run scoreboard players operation @s achivments = @s advancement_count

# =============================================
# Выводим счетчик на экран в реальном времени
# (зеленый текст над панелью инвентаря)
# =============================================
title @a actionbar [{"text":"🏆 Ачивок: ","color":"gold","bold":true},{"score":{"name":"@a","objective":"achivments"},"color":"green","bold":true}]

# =============================================
# Поздравляем, если игрок получил все достижения (опционально)
# =============================================
execute as @a if score @s achivments matches 46.. run tellraw @a [{"text":"🎉 Ты собрал ВСЕ достижения!","color":"light_purple","bold":true}]
